---
/**
 * The page's thesis: a large ASCII mark beside one short claim. One per page —
 * a second one is a section.
 *
 * Side by side rather than stacked, and with no panel around it, so it reads as
 * the page talking rather than as a callout it could skip.
 */

import AsciiMark from "./AsciiMark.astro";

interface Props {
  mark: string;
}

const { mark } = Astro.props;
---

<div class="big-idea">
  <AsciiMark name={mark} class="big-idea-mark" />
  <div class="big-idea-text"><slot /></div>
</div>
