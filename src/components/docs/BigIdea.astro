---
/**
 * The page's thesis: a giant floating emoji beside one short claim. One per
 * page — a second one is a section.
 *
 * Side by side rather than stacked, and with no panel around it, so it reads as
 * the page talking rather than as a callout it could skip.
 */

interface Props {
  emoji: string;
}

const { emoji } = Astro.props;
---

<div class="big-idea">
  <span class="big-idea-emoji" aria-hidden="true">{emoji}</span>
  <div class="big-idea-text"><slot /></div>
</div>
