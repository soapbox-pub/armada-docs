---
/**
 * One section of a feature page: a big floating emoji, the heading beside it,
 * and the body underneath both.
 *
 * The emoji is the navigation. A reader scanning a long how-to finds the part
 * they came for by shape long before they find it by reading — which is the one
 * thing a numbered chip cannot do, since an index tells you where a section
 * sits and never what it is.
 *
 * The heading itself stays ordinary markdown in the slot, so it keeps its `id`
 * and its place in the table of contents. The grid in `docs-page.css` lifts it
 * up beside the emoji.
 */

interface Props {
  emoji: string;
}

const { emoji } = Astro.props;
---

<section class="page-section">
  <span class="section-emoji" aria-hidden="true">{emoji}</span>
  <slot />
</section>
