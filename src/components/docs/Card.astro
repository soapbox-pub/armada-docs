---
/**
 * One card in a {@link Cards} grid: an emoji, a title, and a couple of lines.
 *
 * Renders as an `<a>` when given an `href`, so a card that points somewhere is
 * clickable across its whole surface rather than only on a link buried in its
 * last line.
 */

interface Props {
  emoji?: string;
  href?: string;
}

const { emoji, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="card" href={href} rel={href?.startsWith("http") ? "noreferrer" : undefined}>
  {emoji && <span class="card-emoji" aria-hidden="true">{emoji}</span>}
  <slot />
</Tag>
