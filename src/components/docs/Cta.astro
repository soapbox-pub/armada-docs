---
/**
 * The closing block: an ASCII mark, a heading, a last line, and the actions the
 * page has been building toward.
 *
 * The sign-off underneath is the landing page's prompt — same cyan `$`, same
 * rose line, same blinking caret — so a page ends where the site opened.
 */

import AsciiMark from "./AsciiMark.astro";

interface Props {
  mark: string;
  /** The `$` line. Omit for no sign-off. */
  signOff?: string;
}

const { mark, signOff } = Astro.props;
---

<section class="page-cta">
  <AsciiMark name={mark} class="page-cta-mark" />
  <slot />
  {
    signOff && (
      <p class="sign-off">
        <span class="prompt">$ </span>{signOff}
        <span class="caret" aria-hidden="true">
          _
        </span>
      </p>
    )
  }
</section>
