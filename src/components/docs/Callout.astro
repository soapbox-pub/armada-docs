---
/**
 * An aside to the reader — "you probably don't need this", "this one bites" —
 * as opposed to a Starlight `:::note`, which is an aside about the software.
 * Tinted rather than bordered, so it reads as a friendly interruption.
 */

interface Props {
  emoji?: string;
}

const { emoji = "⚡" } = Astro.props;
---

<aside class="callout">
  <span class="callout-emoji" aria-hidden="true">{emoji}</span>
  <div class="callout-body"><slot /></div>
</aside>
