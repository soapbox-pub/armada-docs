---
/**
 * The homepage: a single full-viewport hero — the crest and wordmark over the
 * ASCII sea, and the two ways into the docs — and then the footer.
 *
 * There is deliberately nothing below the fold. The sea is still `sticky` with
 * its height cancelled, so the small amount of scroll the footer adds lifts the
 * waterline rather than sliding the ocean off the top of the screen.
 */
import AsciiSea from "../components/AsciiSea.astro";
import ArmadaCrest from "../components/brand/ArmadaCrest.astro";
import BrandMark from "../components/brand/BrandMark.astro";
import Landing from "../layouts/Landing.astro";
import { APP_NAME, LINKS, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../consts";

const title = `${SITE_TITLE} — how Armada works, and how to run it yourself`;

/**
 * A `@graph` rather than two sibling blocks: it lets the software and the site
 * that documents it reference each other by `@id`, which is what actually gets
 * them treated as one entity instead of two unrelated hits.
 */
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
      about: { "@id": `${SITE_URL}/#software` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_URL}/#software`,
      name: APP_NAME,
      applicationCategory: "CommunicationApplication",
      operatingSystem: "Linux, Windows, macOS, Android, iOS, Web",
      url: LINKS.app,
      downloadUrl: LINKS.downloads,
      description:
        "Private, end-to-end encrypted communities that need no host, built on Nostr relays.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
  ],
};
---

<Landing title={title} structuredData={structuredData}>
  {/*
    Viewport-locked sea. `sticky` pins it while the negative margin cancels the
    height it would otherwise add to the scroll length, so the hero sits at the
    top of the page rather than after a screenful of ocean.
  */}
  <div class="sea-slot">
    <AsciiSea />
  </div>

  <section class="hero">
    <div class="hero-mark">
      <ArmadaCrest size={150} />
      <BrandMark
        suffix="docs"
        tagline="how it works, and how to run your own"
      />
    </div>

    <div class="hero-actions">
      <a class="btn btn-primary" href="/how-it-works/">Read the docs</a>
      <a class="btn" href="/self-hosting/">Self-host it</a>
    </div>
  </section>
</Landing>

<style>
  .sea-slot {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    margin-bottom: -100svh;
    pointer-events: none;
  }

  .hero {
    /* Above the sea, which the negative margin above has pulled underneath it. */
    position: relative;
    z-index: 10;

    display: flex;
    min-height: 100svh;
    max-width: 36rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin-inline: auto;
    padding-block: 6rem 4rem;
    padding-inline: clamp(1.25rem, 5vw, 2rem);
    text-align: center;
  }

  .hero-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }

  /* The buttons themselves live in `styles/controls.css`, shared with the docs
     pages. Only the hero's own layout of them is here. */
</style>
